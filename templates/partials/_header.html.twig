<header class="site-header">
    <div class="container">
        <a href="/" class="logo-link">
            <img src="{{ asset('../assets/images/logo_iut.png') }}" alt="Logo Banque" class="logo-img">
        </a>
        <nav>
            <a href="/">{{ 'header.home'|trans }}</a>            
            {% if app.user %}
                {% if is_granted('ROLE_MANAGER') %}
                    <a href="{{ path('app_client_index') }}">{{ 'header.clients'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_compte_client') }}">{{ 'header.my_accounts'|trans }}</a>
                {% endif %}
                <a href="{{ path('app_logout') }}">{{ 'Déconnexion'|trans }}</a>
            {% else %}
                <a href="{{ path('app_login') }}">{{ 'Connexion'|trans }}</a>
            {% endif %}
        </nav>
    </div>
    <div class="locale-switcher">
        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params') | merge({'_locale': 'fr'})) }}" class="locale-link" aria-label="Français">
            <span class="flag-emoji" aria-hidden="true">🇫🇷</span>
        </a>
        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params') | merge({'_locale': 'en'})) }}" class="locale-link" aria-label="English">
            <span class="flag-emoji" aria-hidden="true">🇬🇧</span>
        </a>
    </div>
</header>
