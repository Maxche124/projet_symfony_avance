{% extends 'base.html.twig' %}

{% block title %}Compte{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('../assets/styles/app.css') }}">
    <h1>{{ 'ShowAccount.title'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ 'AccountList.id'|trans }}</th>
                <td>{{ compte.id }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.accountNumber'|trans }}</th>
                <td>{{ compte.numero }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.balance'|trans }}</th>
                <td>{{ compte.solde }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.overdraftAuthorized'|trans }}</th>
                <td>{{ compte.getDecouvertStatus() ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.overdraft'|trans }}</th>
                <td>{{ compte.getMontantDecouvert() }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-sm btn-outline-secondary mt-3" href="{{ path('app_compte_index') }}">{{ 'backToList'|trans }}</a>

    <a class="btn btn-sm btn-outline-primary mt-3" href="{{ path('app_compte_edit', {'id': compte.id}) }}">{{ 'AccountList.edit'|trans }}</a>

    {{ include('compte/_delete_form.html.twig') }}
{% endblock %}
