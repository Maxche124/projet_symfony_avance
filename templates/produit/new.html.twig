{% extends 'base.html.twig' %}

{% block title %}Nouveau produit{% endblock %}

{% block body %}

<h1>{{ 'NewProduit.title'|trans }}</h1>

{# Progression #}

<div class="progress mb-4">
    {% for i in 1..total_steps %}
        <div class="progress-step {{ step >= i ? 'active' : '' }}">
            {{ i }}
        </div>
    {% endfor %}
</div>

{# Formulaire étape #}

<h3>
    {% if step == 1 %}Type de produit{% endif %}
    {% if step == 2 %}Détails produit{% endif %}
    {% if step == 3 %}Logistique / Licence{% endif %}
    {% if step == 4 %}Confirmation{% endif %}
</h3>

{{ form_start(form) }}
    {{ form_widget(form) }}

    <div class="mt-3 d-flex justify-content-between">

        {% if step > 1 %}
            <a class="btn btn-secondary"
               href="{{ path('app_produit_new', {'action':'prev'}) }}">
                Précédent
            </a>
        {% endif %}

        <button class="btn btn-primary">
            {% if step == total_steps %}
                Valider
            {% else %}
                Suivant
            {% endif %}
        </button>

    </div>

{{ form_end(form) }}

{% endblock %}