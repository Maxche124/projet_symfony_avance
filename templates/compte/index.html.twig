{% extends 'base.html.twig' %}

{% block title %}Compte index{% endblock %}

{% block body %}
    <h1>Compte index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{ 'AccountList.id'|trans }}</th>
                <th>{{ 'AccountList.accountNumber'|trans }}</th>
                <th>{{ 'AccountList.balance'|trans }}</th>
                <th>{{ 'AccountList.overdraftAuthorized'|trans }}</th>
                <th>{{ 'AccountList.overdraft'|trans }}</th>
                <th>{{ 'AccountList.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for compte in comptes %}
            <tr>
                <td>{{ compte.id }}</td>
                <td>{{ compte.numero }}</td>
                <td>{{ compte.solde }}</td>
                <td>{{ compte.getDecouvertStatus() ? 'Yes' : 'No' }}</td>
                <td>{{ compte.getMontantDecouvert() }}</td>
                <td>
                    <a href="{{ path('app_compte_show', {'id': compte.id}) }}">{{ 'AccountList.show'|trans }}</a>
                    <a href="{{ path('app_compte_edit', {'id': compte.id}) }}">{{ 'AccountList.edit'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">{{ 'AccountList.noAccount'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_compte_new') }}">{{ 'AccountList.new'|trans }}</a>
{% endblock %}
