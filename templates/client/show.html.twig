{% extends 'base.html.twig' %}

{% block title %}Client{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('../assets/styles/app.css') }}">
    <h1>{{ 'ShowClient.title'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ 'ClientList.id'|trans }}</th>
                <td>{{ client.id }}</td>
            </tr>
            <tr>
                <th>{{ 'ClientList.customerNumber'|trans }}</th>
                <td>{{ client.numero }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-sm btn-outline-secondary mt-3" href="{{ path('app_client_index') }}">{{ 'backToList'|trans }}</a>

    <a class="btn btn-sm btn-outline-primary mt-3" href="{{ path('app_client_edit', {'id': client.id}) }}">{{ 'ClientList.edit'|trans }}</a>

    {{ include('client/_delete_form.html.twig') }}
{% endblock %}
