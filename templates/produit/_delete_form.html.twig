<form method="post"
      action="{{ path('app_produit_delete', {'id': produit.id}) }}"
      onsubmit="return confirm('Are you sure you want to delete this item?'|trans);">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ produit.id) }}">

    <button class="btn btn-sm btn-danger mt-3">
        {{ 'Delete'|trans }}
    </button>
</form>