{% extends 'base.html.twig' %}

{% block title %}Compte{% endblock %}

{% block body %}
    <h1>{{ 'ShowAccount.title'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ 'AccountList.id'|trans }}</th>
                <td>{{ compte.id }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.accountNumber'|trans }}</th>
                <td>{{ compte.numero }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.balance'|trans }}</th>
                <td>{{ compte.solde }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.overdraftAuthorized'|trans }}</th>
                <td>{{ compte.decouvertAutorise ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>{{ 'AccountList.overdraft'|trans }}</th>
                <td>{{ compte.decouvert }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_compte_index') }}">{{ 'backToList'|trans }}</a>

    <a href="{{ path('app_compte_edit', {'id': compte.id}) }}">{{ 'AccountListe.edit'|trans }}</a>

    {{ include('compte/_delete_form.html.twig') }}
{% endblock %}
