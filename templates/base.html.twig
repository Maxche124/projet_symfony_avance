<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Application{% endblock %}</title>

    {% block stylesheets %}
        <style>
            html, body {
                height: 100vh;
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f4f6f9;
            }

            body {
                display: flex;
            }

            .sidebar {
                width: 250px;
                background: #1e3a8a;
                color: white;

                display: flex;
                flex-direction: column;
                justify-content: space-between;

                padding: 20px;
                position: fixed;
                height: 100vh;

            }

            .sidebar-top {
                display: flex;
                flex-direction: column;
                gap: 25px;
            }

            .sidebar-top-actions {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .logo-img {
                width: 100%;
                max-height: 70px;
                object-fit: contain;
            }

            .sidebar-nav {
                display: flex;
                flex-direction: column;
                gap: 15px;
            }

            .sidebar-nav a {
                color: white;
                text-decoration: none;
                font-weight: 600;
                padding: 8px 12px;
                border-radius: 6px;
                transition: background 0.2s ease;
            }

            .sidebar-nav a:hover {
                background: rgba(255,255,255,0.15);
            }

            /* Partie basse */

            .sidebar-bottom {
                display: flex;
                flex-direction: column;
                gap: 15px;
                font-size: 14px;
            }

            .logout-link {
                color: #f87171;
                font-weight: bold;
                text-decoration: none;
            }

            .locale-switcher {
                display: flex;
                gap: 10px;
                font-size: 20px;
            }

            .main-content {
                flex: 1;
                margin-left: 250px; /* largeur sidebar */
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            main {
                flex: 1;
                padding: 40px;
                margin-left: 30px;
            }

            .site-footer {
                background: #111827;
                color: white;
                text-align: center;
                padding: 20px;
            }

            .table th a {
                text-decoration: none;
                color: inherit;
                font-weight: bold;
            }

            .table th a:hover {
                text-decoration: underline;
                cursor: pointer;
            }
        </style>
    {% endblock %}

    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>

    {% include 'partials/_header.html.twig' %}

    <div class="main-content">
        <main>
            {% block body %}{% endblock %}
        </main>

        {% include 'partials/_footer.html.twig' %}
    </div>

</body>
</html>