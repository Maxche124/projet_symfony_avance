{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('../assets/styles/app.css') }}">
    <h1>{{ 'ShowUser.title'|trans }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>{{ 'UserList.id'|trans }}</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.email'|trans }}</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.roles'|trans }}</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.password'|trans }}</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.firstName'|trans }}</th>
                <td>{{ user.firstName }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.lastName'|trans }}</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.address'|trans }}</th>
                <td>{{ user.adresse }}</td>
            </tr>
            <tr>
                <th>{{ 'UserList.gender'|trans }}</th>
                <td>{{ user.gender }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-sm btn-outline-secondary mt-3" href="{{ path('app_user_index') }}">{{ 'backToList'|trans }}</a>

    <a class="btn btn-sm btn-outline-primary mt-3" href="{{ path('app_user_edit', {'id': user.id}) }}">{{ 'UserList.edit'|trans }}</a>

    {{ include('user/_delete_form.html.twig') }}
{% endblock %}
