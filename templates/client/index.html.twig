{% extends 'base.html.twig' %}

{% block title %}Client index{% endblock %}

{% block body %}
    <h1>{{ 'ClientList.title'|trans }}</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{ 'ClientList.id'|trans }}</th>
                <th>{{ 'ClientList.customerNumber'|trans }}</th>
                <th>{{ 'ClientList.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for client in clients %}
            <tr>
                <td>{{ client.id }}</td>
                <td>{{ client.numero }}</td>
                <td>
                    <a href="{{ path('app_client_show', {'id': client.id}) }}">{{ 'ClientList.show'|trans }}</a>
                    <a href="{{ path('app_client_edit', {'id': client.id}) }}">{{ 'ClientList.edit'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{{ 'ClientList.noClient'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_client_new') }}">{{ 'ClientList.new'|trans }}</a>
{% endblock %}
