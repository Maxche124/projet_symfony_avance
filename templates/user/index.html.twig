{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('../assets/styles/app.css') }}">
    <h1>User index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>{{ 'UserList.id'|trans }}</th>
                <th>{{ 'UserList.email'|trans }}</th>
                <th>{{ 'UserList.roles'|trans }}</th>
                <th>{{ 'UserList.password'|trans }}</th>
                <th>{{ 'UserList.firstName'|trans }}</th>
                <th>{{ 'UserList.lastName'|trans }}</th>
                <th>{{ 'UserList.address'|trans }}</th>
                <th>{{ 'UserList.gender'|trans }}</th>
                <th>{{ 'UserList.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>{{ user.password }}</td>
                <td>{{ user.firstName }}</td>
                <td>{{ user.lastName }}</td>
                <td>{{ user.adresse }}</td>
                <td>{{ user.gender }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_user_show', {'id': user.id}) }}">{{ 'UserList.show'|trans }}</a>
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_user_edit', {'id': user.id}) }}">{{ 'UserList.edit'|trans }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">{{ 'UserList.noUser'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary mt-3" href="{{ path('app_user_new') }}">{{ 'UserList.new'|trans }}</a>
{% endblock %}
