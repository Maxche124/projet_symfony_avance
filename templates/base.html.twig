<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Application{% endblock %}</title>

    {% block stylesheets %}
        <style>
            html, body {
                height: 100%;
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f4f6f9;
            }

            body {
                display: flex;
            }

            /* ===== SIDEBAR ===== */

            .sidebar {
                width: 250px;
                background: #1e3a8a;
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 25px 15px;
            }

            .sidebar-top {
                display: flex;
                flex-direction: column;
                gap: 30px;
            }

            .logo-img {
                width: 100%;
                max-height: 80px;
                object-fit: contain;
            }

            .sidebar-nav {
                display: flex;
                flex-direction: column;
                gap: 15px;
            }

            .sidebar-nav a {
                color: white;
                text-decoration: none;
                font-weight: 600;
                padding: 8px 12px;
                border-radius: 6px;
                transition: background 0.2s ease;
            }

            .sidebar-nav a:hover {
                background: rgba(255,255,255,0.15);
            }

            .sidebar-bottom {
                display: flex;
                flex-direction: column;
                gap: 15px;
                font-size: 14px;
            }

            .logout-link {
                color: #f87171;
                text-decoration: none;
                font-weight: bold;
            }

            .locale-switcher {
                display: flex;
                gap: 10px;
                font-size: 20px;
            }

            /* ===== MAIN CONTENT ===== */

            .main-content {
                flex: 1;
                padding: 40px;
            }

            /* ===== FOOTER ===== */

            .site-footer {
                background: #111827;
                color: white;
                text-align: center;
                padding: 20px 0;
            }
        </style>
    {% endblock %}

    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>

    {% include 'partials/_header.html.twig' %}

    <div class="main-content">
        {% block body %}{% endblock %}
    </div>

</body>
</html>