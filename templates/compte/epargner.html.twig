{% extends 'base.html.twig' %}

{% block title %}{{ 'EpargnerAccount.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'EpargnerAccount.title'|trans }}</h1>

    <table class="table">
        <tr><th>{{ 'AccountList.accountNumber'|trans }}</th><td>{{ compte.numero }}</td></tr>
        <tr><th>{{ 'AccountList.balance'|trans }}</th><td>{{ compte.solde }}</td></tr>
        <tr><th>{{ 'AccountList.overdraftAuthorized'|trans }}</th><td>{{ compte.getDecouvertStatus() ? 'Yes' : 'No' }}</td></tr>
        <tr><th>{{ 'AccountList.overdraft'|trans }}</th><td>{{ compte.getMontantDecouvert() }}</td></tr>
    </table>

    <form method="post">
        <div class="form-group">
            <label for="montant">{{ 'form.amount'|trans }}</label>
            <input type="number" step="0.01" name="montant" id="montant" required class="form-control">
        </div>
        <button class="btn btn-primary mt-2">{{ 'AccountList.spar'|trans }}</button>
    </form>

    <a href="{{ path('app_compte_client') }}" class="btn btn-link mt-3">{{ 'backToList'|trans }}</a>
{% endblock %}