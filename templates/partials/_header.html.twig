<header class="site-header">
    <div class="container">
        <a href="/" class="logo-link">
            <img src="{{ asset('../assets/images/logo_iut.png') }}" alt="Logo Banque" class="logo-img">
        </a>
        <nav>
            <a href="/">{{ 'header.home'|trans }}</a>
            <a href="{{ path('app_login') }}">{{ 'connexion'|trans }}</a>
        </nav>
    </div>
    <div>
        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params') | merge({'_locale': 'fr'})) }}">
            <img src="{{ asset('assets/images/fr-flag.png') }}" alt="FR" class="rounded" width="24">
        </a>
        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params') | merge({'_locale': 'en'})) }}">
            <img src="{{ asset('assets/images/en-flag.png') }}" alt="EN" class="rounded" width="24">
        </a>
    </div>
</header>
